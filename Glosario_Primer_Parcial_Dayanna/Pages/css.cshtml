@page
@model Glosario_Primer_Parcial_Dayanna.Pages.cssModel

@{
    ViewData["Title"] = "Glosario CSS";
}

<div style="font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto; padding: 20px;">

    <h1 style="color: #264de4; border-bottom: 2px solid #264de4;">
        Glosario de CSS
    </h1>

    <ul style="list-style-type: none; padding: 0;">

        @foreach (var termino in cssModel.GlosarioCss)
        {
            <li style="background-color: #f4f4f4; margin-bottom: 15px; padding: 15px; border-left: 5px solid #264de4;">

                <h3 style="margin: 0 0 10px 0; color: #333;">
                    @termino.Palabra
                </h3>

                <p style="margin: 0; color: #555;">
                    @termino.Definicion
                </p>

                <small style="color: #999; display: block; margin-top: 10px;">
                    Agregado: @termino.FechaAgregado.ToString("g")
                </small>

            </li>
        }

    </ul>

    <hr style="margin: 40px 0;" />

    <h2 style="color: #333;">Agregar Etiqueta CSS</h2>

    <form method="post" style="background-color: #ffebe6; padding: 20px; border-radius: 8px;">

        <div style="margin-bottom: 15px;">
            <label>Etiqueta:</label>
            <input type="text" name="nuevaPalabra" placeholder="Ej. body" required style="width:100%; padding:8px;" />
        </div>

        <div style="margin-bottom: 15px;">
            <label>Definición:</label>
            <input type="text" name="nuevaDefinicion" required style="width:100%; padding:8px;" />
        </div>

        <button type="submit" style="background-color:#e34c26; color:white; border:none; padding:10px 20px;">
            Guardar Etiqueta
        </button>

    </form>

</div>